# Copy to wabot.env (or export before running) — never commit wabot.env.
# Required for the HTTP API:
WABOT_TOKEN=change-me-use-openssl-rand-hex-32

# Optional: HTTP listen address (default 127.0.0.1:7777). Use 0.0.0.0:7777 only in Docker or behind a trusted proxy.
# WABOT_HTTP_ADDR=127.0.0.1:7777

# Optional: append-only JSON log of API sends (default ./sends.log)
# WABOT_SEND_LOG=/opt/wabot/sends.log

# Optional: rate limit (defaults 20/min, burst 5). Set either to 0 to disable.
# WABOT_RATE_PER_MIN=20
# WABOT_RATE_BURST=5

# Optional: inbound webhook — POST JSON for every incoming message (not from you)
# WABOT_INBOUND_URL=http://127.0.0.1:9000/whatsapp/inbound
# WABOT_INBOUND_TOKEN=
# WABOT_INBOUND_TIMEOUT_SEC=10
